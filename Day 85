CREATE TABLE books (
    book_id SERIAL PRIMARY KEY,
    title TEXT,
    author TEXT,
    copies INT
);
CREATE OR REPLACE FUNCTION issue_book(p_book_id INT)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
DECLARE
    current_copies INT;
BEGIN
    SELECT copies
    INTO current_copies
    FROM books
    WHERE book_id = p_book_id;

    IF current_copies > 0 THEN
        UPDATE books
        SET copies = copies - 1
        WHERE book_id = p_book_id;

        RETURN 'Book issued successfully';
    ELSE
        RETURN 'Book is out of stock';
    END IF;
END;
$$;

SELECT issue_book(1);

ALTER TABLE books
ADD COLUMN status TEXT;


CREATE OR REPLACE PROCEDURE update_book_status()
LANGUAGE plpgsql
AS $$
DECLARE
    rec RECORD;
BEGIN
    FOR rec IN
        SELECT book_id, copies
        FROM books
    LOOP
        IF rec.copies = 0 THEN
            UPDATE books
            SET status = 'Out of Stock'
            WHERE book_id = rec.book_id;
        END IF;
    END LOOP;
END;
$$;

CALL update_book_status();


CREATE OR REPLACE FUNCTION check_book_availability(p_book_id INT)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
DECLARE
    book_copies INT;
BEGIN
    SELECT copies
    INTO book_copies
    FROM books
    WHERE book_id = p_book_id;

    IF book_copies > 0 THEN
        RETURN 'Available';
    ELSE
        RETURN 'Not Available';
    END IF;
END;
$$;
